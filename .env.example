APP_ENV=development
APP_CONSENT_POLICY_VERSION=2026-08-18
APP_INVITATION_TTL=168h
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_SHUTDOWN_TIMEOUT=10s
POSTGRES_DB=anamnesys
POSTGRES_USER=anamnesys
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://anamnesys:change-me@localhost:5432/anamnesys?sslmode=disable
DATABASE_CONNECT_TIMEOUT=10s
AUTH_ISSUER=anamnesys-api
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64-encoded-32-byte-ed25519-seed
AUTH_DATA_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_EMAIL_VERIFICATION_TOKEN_TTL=24h
AUTH_PASSWORD_RESET_TOKEN_TTL=30m
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_EXPOSE_DEVELOPMENT_TOKENS=true
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_DISPLAY_NAME=Anamnesys
AUTH_WEBAUTHN_ORIGINS=http://localhost:3000
AUTH_WEBAUTHN_CEREMONY_TTL=5m
COMPANION_ENABLED=true
COMPANION_BASE_URL=http://localhost:8000
COMPANION_API_KEY=replace-with-a-service-to-service-secret
COMPANION_TIMEOUT=20s
COMPANION_HISTORY_MESSAGES=20
AI_CONTEXT_WORKER_ENABLED=true
AI_CONTEXT_WORKER_CONCURRENCY=2
AI_CONTEXT_WORKER_POLL_INTERVAL=1s
AI_CONTEXT_WORKER_LEASE=2m
AI_CONTEXT_WORKER_MAX_ATTEMPTS=3
AI_PROVIDER=mock
AI_OPENAI_API_KEY=
AI_OPENAI_STORE=false
AI_CONVERSATION_MODEL=gpt-5.6-terra
AI_AUXILIARY_MODEL=gpt-5.6-luna
AI_REPORT_MODEL=gpt-5.6-terra
AI_MODERATION_MODEL=omni-moderation-latest
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
AI_CONVERSATION_REASONING=low
AI_AUXILIARY_REASONING=low
AI_REPORT_REASONING=medium
AI_REPORT_DIRECT_INPUT_CHARACTERS=80000
AI_REPORT_CHUNK_CHARACTERS=40000
AI_REPORT_EXTRACTION_CONCURRENCY=4
